# DocMesh Document Service v0.4.0 deployment template.
# This file is NOT loaded automatically. Export these values or inject them
# through your container/orchestrator. Never commit real credentials.

# -----------------------------------------------------------------------------
# Application / public URL
# See docs/prd.md (FR-APP, FR-SEC, FR-OPS) and docs/srs.md
# (SRS-ARC, SRS-CFG, SRS-OPS, SRS-API).
# -----------------------------------------------------------------------------
DOCMESH_ENV=development
# DOCMESH_SECURITY_MODE=production
# DOCMESH_PRODUCTION_ALIASES=prod,production
ROOT_PATH=
TOKEN_URL=/token
CORS_ORIGINS=http://127.0.0.1:3000
CORS_CREDENTIALS=false

DOCMESH_LOG_LEVEL=INFO
APP_LOG_JSON=true
APP_LOG_FORCE=false
ACCESS_LOG_ENABLED=true
ACCESS_LOG_HEALTH_ENABLED=false
# APP_LOG_PATH=/var/log/docmesh/document-service.log

# -----------------------------------------------------------------------------
# Runtime / readiness
# PostgreSQL and MinIO are assembled by DMS; do not add them to these lists.
# -----------------------------------------------------------------------------
DOCMESH_SERVICES='postgres,minio,keycloak'
READINESS_REQUIRED_SERVICES='postgres,minio,keycloak'
DOCMESH_HEALTHCHECK_ENABLED=true
DOCMESH_STARTUP_FAILURE_MODE=fail
DOCMESH_STARTUP_HEALTHCHECK_ATTEMPTS=1
DOCMESH_STARTUP_HEALTHCHECK_RETRY_DELAY_SECONDS=0
READINESS_PARALLEL=false
# READINESS_TIMEOUT_SECONDS=5
# READINESS_OVERALL_TIMEOUT_SECONDS=30
# DOCMESH_SERVICE_ALTERNATIVES=

# -----------------------------------------------------------------------------
# DMS assembly
# Production uses postgresql. Local development may select sqlite below.
# DMS_METADATA_BACKEND accepts postgresql (default) or sqlite.
# DMS_CONFIGURATION_STRICT defaults to false; this template enables strict
# diagnosis so ambiguous backend selection and a missing MinIO bucket fail early.
# The host adapter reads these variables; dms itself does not read the process
# environment or create storage clients.
# POSTGRES_DSN is unsupported and must not be set.
# -----------------------------------------------------------------------------
DMS_METADATA_BACKEND=postgresql
DMS_CONFIGURATION_STRICT=true

# -----------------------------------------------------------------------------
# PostgreSQL metadata store (CFG-STORAGE)
# Required when DMS_METADATA_BACKEND=postgresql.
# Replace credentials through a secret mechanism.
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SSLMODE=prefer
POSTGRES_CONNECT_TIMEOUT_SECONDS=10
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10
POSTGRES_POOL_PRE_PING=true
POSTGRES_POOL_RECYCLE_SECONDS=-1
POSTGRES_ECHO=false
POSTGRES_APPLICATION_NAME=docmesh-document-service

# -----------------------------------------------------------------------------
# MinIO object store (CFG-STORAGE)
# Required for both PostgreSQL and SQLite metadata backends.
# Production security mode requires SECURE=true and CERT_CHECK=true.
# -----------------------------------------------------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password123
MINIO_BUCKET=default
MINIO_SECURE=false
MINIO_CERT_CHECK=true
# MINIO_REGION=
MINIO_REQUEST_TIMEOUT_SECONDS=30
MINIO_MAX_RETRIES=3

# -----------------------------------------------------------------------------
# Keycloak authentication (CFG-AUTH)
# Required by the default create_application(include_auth_router=True).
# -----------------------------------------------------------------------------
KEYCLOAK_URL=http://192.168.219.106:8080
KEYCLOAK_REALM=docmesh
KEYCLOAK_CLIENT_ID=document
KEYCLOAK_CLIENT_SECRET=<keycloak-client-secret>
KEYCLOAK_CLIENT_PUBLIC=false
KEYCLOAK_VERIFY_SSL=false
# KEYCLOAK_AUDIENCE=docmesh-document-service
KEYCLOAK_TOKEN_GRANT_TYPE=password
# KEYCLOAK_TOKEN_SCOPE=openid
KEYCLOAK_REQUEST_TIMEOUT_SECONDS=10
KEYCLOAK_MAX_RETRIES=3
KEYCLOAK_JWKS_CACHE_TTL_SECONDS=300
KEYCLOAK_TOKEN_USERNAME=test
KEYCLOAK_TOKEN_PASSWORD=test

# -----------------------------------------------------------------------------
# Local SQLite alternative (CFG-STORAGE)
# To use: set DMS_METADATA_BACKEND=sqlite, uncomment SQLITE_PATH, and remove
# PostgreSQL variables from the injected environment. MinIO remains required.
# -----------------------------------------------------------------------------
# SQLITE_PATH=./docmesh-metadata.sqlite3
# SQLITE_READONLY=false
# SQLITE_ENABLE_WAL=true
# SQLITE_BUSY_TIMEOUT_MS=5000
# SQLITE_CHECK_SAME_THREAD=false
# SQLITE_ECHO=false

# -----------------------------------------------------------------------------
# Integration-test-only Keycloak user. Do not keep a fixed user password in
# the normal production environment.
# -----------------------------------------------------------------------------
# KEYCLOAK_TOKEN_USERNAME=<integration-test-user>
# KEYCLOAK_TOKEN_PASSWORD=<integration-test-password>

# hermes-agent
HERMES_HOME="/workspaces/docmesh-doc/.hermes"
WIKI_PATH='/workspaces/docmesh-doc/wiki'

# Runtime
TZ='Asia/Seoul'
