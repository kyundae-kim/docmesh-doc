# DocMesh Document Service environment template
#
# This file is not loaded automatically. Copy the required values into the
# runtime environment, Docker Compose env_file, or an external secret store.
# Replace all example credentials before running outside local development.

# Metadata backend: postgresql (default) or sqlite.
DMS_METADATA_BACKEND=postgresql

# PostgreSQL metadata store.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=docmesh
POSTGRES_USER=docmesh
POSTGRES_PASSWORD=change-me
# POSTGRES_SSLMODE=prefer

# MinIO object store. Required for both PostgreSQL and SQLite backends.
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=documents
MINIO_SECURE=false
# MINIO_REGION=

# Optional application settings.
# ROOT_PATH=/dms
# CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# DMS_MAX_FILE_SIZE=10485760

# SQLite alternative for local development.
# When enabled, remove or unset the POSTGRES_* variables above.
# DMS_METADATA_BACKEND=sqlite
# SQLITE_PATH=./data/docmesh.sqlite3
# Use SQLITE_PATH=:memory: for a process-local database.

# Compatibility alias for MINIO_ACCESS_KEY, if required by an existing setup.
# MINIO_ACCESS_KEY_ID=minioadmin

# POSTGRES_DSN is intentionally not included: it is unsupported by the host
# adapter. Configure PostgreSQL with the individual POSTGRES_* fields above.
