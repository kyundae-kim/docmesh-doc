# This file is a deployment template and is not loaded automatically.
# Keep real secrets outside version control. Replace all placeholder endpoints
# and credentials before enabling startup checks.

# -----------------------------------------------------------------------------
# Common runtime and DMS SDK assembly
# -----------------------------------------------------------------------------
DOCMESH_ENV=development
DOCMESH_SECURITY_MODE=
DOCMESH_PRODUCTION_ALIASES=prod,production
DOCMESH_HEALTHCHECK_ENABLED=false
DMS_METADATA_BACKEND=postgresql
DMS_CONFIGURATION_STRICT=true

# -----------------------------------------------------------------------------
# fastapi-core AppConfig
# For the Traefik /dms deployment, use ROOT_PATH=/dms and TOKEN_URL=/dms/token.
# -----------------------------------------------------------------------------
ROOT_PATH=
TOKEN_URL=/token
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_CREDENTIALS=false
READINESS_PARALLEL=false
READINESS_TIMEOUT_SECONDS=5
READINESS_OVERALL_TIMEOUT_SECONDS=15
DOCMESH_SERVICE_ALTERNATIVES=
DOCMESH_STARTUP_FAILURE_MODE=fail
DOCMESH_STARTUP_HEALTHCHECK_ATTEMPTS=1
DOCMESH_STARTUP_HEALTHCHECK_RETRY_DELAY_SECONDS=0
DOCMESH_LOG_LEVEL=INFO
APP_LOG_PATH=
APP_LOG_JSON=true
APP_LOG_FORCE=false
ACCESS_LOG_ENABLED=true
ACCESS_LOG_HEALTH_ENABLED=false

# The document API uses Keycloak authentication. Every required service must
# also be present in DOCMESH_SERVICES.
DOCMESH_SERVICES=keycloak
READINESS_REQUIRED_SERVICES=keycloak

# -----------------------------------------------------------------------------
# Keycloak
# -----------------------------------------------------------------------------
KEYCLOAK_URL=https://keycloak.example.com
KEYCLOAK_REALM=docmesh
KEYCLOAK_CLIENT_ID=docmesh-document-service
KEYCLOAK_CLIENT_SECRET=replace-me
KEYCLOAK_CLIENT_PUBLIC=false
KEYCLOAK_VERIFY_SSL=true
# KEYCLOAK_AUDIENCE=
# KEYCLOAK_REQUEST_TIMEOUT_SECONDS=10
# KEYCLOAK_MAX_RETRIES=3
# KEYCLOAK_JWKS_CACHE_TTL_SECONDS=300

# Used only by password-grant integration tests.
# KEYCLOAK_TOKEN_USERNAME=
# KEYCLOAK_TOKEN_PASSWORD=replace-me

# -----------------------------------------------------------------------------
# Metadata store: PostgreSQL (selected above)
# DMS v0.6.0 requires individual fields and rejects legacy POSTGRES_DSN.
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres.example.com
POSTGRES_PORT=5432
POSTGRES_DB=docmesh
POSTGRES_USER=docmesh
POSTGRES_PASSWORD=replace-me
# POSTGRES_SSLMODE=prefer
# POSTGRES_CONNECT_TIMEOUT_SECONDS=10
# POSTGRES_POOL_SIZE=5
# POSTGRES_MAX_OVERFLOW=10
# POSTGRES_POOL_PRE_PING=false
# POSTGRES_POOL_RECYCLE_SECONDS=-1
# POSTGRES_ECHO=false
# POSTGRES_APPLICATION_NAME=docmesh-document-service

# -----------------------------------------------------------------------------
# Metadata store alternative: SQLite
# To use it, set DMS_METADATA_BACKEND=sqlite, comment out the POSTGRES_* block,
# and uncomment SQLITE_PATH. SQLite replaces metadata storage only; MinIO is
# still required for document content.
# -----------------------------------------------------------------------------
# SQLITE_PATH=/tmp/docmesh-doc.db
# SQLITE_READONLY=false
# SQLITE_ENABLE_WAL=false
# SQLITE_BUSY_TIMEOUT_MS=5000
# SQLITE_CHECK_SAME_THREAD=false
# SQLITE_ECHO=false

# -----------------------------------------------------------------------------
# Object storage: MinIO
# -----------------------------------------------------------------------------
MINIO_ENDPOINT=minio.example.com:9000
MINIO_ACCESS_KEY=minio-access-key
MINIO_SECRET_KEY=replace-me
MINIO_BUCKET=documents
MINIO_SECURE=true
# MINIO_CERT_CHECK=true
# MINIO_REGION=
# MINIO_REQUEST_TIMEOUT_SECONDS=30
# MINIO_MAX_RETRIES=3

# Integration tests reuse the POSTGRES_*/MINIO_* values above. Do not add
# separate test-only credential aliases.
