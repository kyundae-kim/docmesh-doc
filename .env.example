# DocMesh Document Service environment template (dms-core 0.10.0)
#
# This file is not loaded automatically. Docker Compose currently injects
# .release/.env; otherwise copy the required values into the runtime
# environment or an external secret store.
# DmsSettings consumes these values; dms-core does not load .env files or
# create the database and MinIO clients.
# Replace all example credentials before running outside local development.

# Metadata backend: postgresql (default) or sqlite.
DMS_METADATA_BACKEND=postgresql

# PostgreSQL metadata store. Required when postgresql is selected.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=docmesh
POSTGRES_USER=docmesh
POSTGRES_PASSWORD=change-me
# Optional TLS query parameter for the host-created SQLAlchemy engine.
# POSTGRES_SSLMODE=prefer
# Use require when TLS is mandatory in production.

# MinIO object store. Required for both metadata backends. The dms-core 0.10
# factory may discover or create the bucket during runtime assembly.
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=documents
MINIO_SECURE=false
# MINIO_REGION=

# Optional application settings.
# ROOT_PATH=/dms
# CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# DMS_MAX_FILE_SIZE is expressed in bytes.
# DMS_MAX_FILE_SIZE=10485760

# SQLite alternative for local development.
# Change the active DMS_METADATA_BACKEND above to sqlite, remove or unset the
# POSTGRES_* variables above, and provide SQLITE_PATH.
# SQLITE_PATH=./data/docmesh.sqlite3
# Use SQLITE_PATH=:memory: for a process-local database.

# Compatibility alias for MINIO_ACCESS_KEY. Remove MINIO_ACCESS_KEY above
# before using this fallback; the canonical spelling takes precedence.
# MINIO_ACCESS_KEY_ID=minioadmin

# POSTGRES_DSN is intentionally not included: it is unsupported by the host
# adapter. Configure PostgreSQL with the individual POSTGRES_* fields above.
# DMS_CONFIGURATION_STRICT and other framework/service settings are not read
# by the current host adapter and should not be added here.
